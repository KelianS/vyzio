# Settings of compose.yml: copy this file to .env beside it, then adjust. The API's own settings,
# the last two here included, are described in CONTRIBUTING.md.

# The Vyzio release to run; changing it is how you update (https://github.com/KelianS/vyzio/releases).
VYZIO_VERSION=0.3.0

# Folder holding the configuration, the database and the recordings; keep it on a disk with room.
VYZIO_DATA_DIR=./data

# Port of the dashboard on this host: http://<SERVER_IP>:<port>.
VYZIO_PORT=8080

# Time zone, as an IANA name.
VYZIO_TIME_ZONE=Europe/Paris

# Networks searched for cameras, comma-separated.
VYZIO_DISCOVERY_PROBE_CIDRS=192.168.0.0/24,192.168.1.0/24
